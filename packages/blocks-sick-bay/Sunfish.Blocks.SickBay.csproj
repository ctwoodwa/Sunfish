<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sunfish.Blocks.SickBay</PackageId>
    <RootNamespace>Sunfish.Blocks.SickBay</RootNamespace>
    <Description>Block-tier reference implementations for the Sick Bay aggregation surface (ADR 0082): SickBayDataProvider (k=3-anonymized pharmacy + Mission Envelope projections), DefaultStretcherBearerPolicy, DefaultFirstAidSurface (built-in hint library for pharmacy/lab/atmosphere), and NoopKeyRotationScheduler. Per W#54 Phase 2. Critical invariant (H4): NO IFieldDecryptor reference anywhere in the implementation graph.</Description>
    <PackageTags>sunfish;blocks;sick-bay;adr-0082</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Sunfish.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Sunfish.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-mission-space\Sunfish.Foundation.MissionSpace.csproj" />
    <ProjectReference Include="..\foundation-ship-common\Sunfish.Foundation.Ship.Common.csproj" />
    <ProjectReference Include="..\foundation-sick-bay\Sunfish.Foundation.SickBay.csproj" />
    <ProjectReference Include="..\kernel-audit\Sunfish.Kernel.Audit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sunfish.Blocks.SickBay.Tests" />
  </ItemGroup>
</Project>
