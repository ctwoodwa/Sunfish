<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sunfish.Bridge.Client\Sunfish.Bridge.Client.csproj" />
    <ProjectReference Include="..\Sunfish.Bridge.Data\Sunfish.Bridge.Data.csproj" />
    <ProjectReference Include="..\Sunfish.Bridge.ServiceDefaults\Sunfish.Bridge.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\packages\foundation-catalog\Sunfish.Foundation.Catalog.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-subscriptions\Sunfish.Blocks.Subscriptions.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-tenant-admin\Sunfish.Blocks.TenantAdmin.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-businesscases\Sunfish.Blocks.BusinessCases.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-public-listings\Sunfish.Blocks.PublicListings.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-property-leasing-pipeline\Sunfish.Blocks.PropertyLeasingPipeline.csproj" />
    <!-- Relay-posture dependencies (ADR 0026 Posture B). Referenced by
         Sunfish.Bridge.Relay.* and only composed when
         BridgeOptions.Mode == Relay. SaaS posture does not activate them. -->
    <ProjectReference Include="..\..\..\packages\kernel-sync\Sunfish.Kernel.Sync.csproj" />
    <ProjectReference Include="..\..\..\packages\kernel-security\Sunfish.Kernel.Security.csproj" />
    <!-- W#23 P4.5 — Bridge audit emission for field-event + field-blob endpoints
         (Option C in-memory v1 per the audit-infra unblock addendum). -->
    <ProjectReference Include="..\..\..\packages\kernel-audit\Sunfish.Kernel.Audit.csproj" />
    <!-- W#56 Phase 1 — SystemRequirements JSON contract + Bridge endpoint. -->
    <ProjectReference Include="..\..\..\packages\foundation-mission-space\Sunfish.Foundation.MissionSpace.csproj" />
    <!-- W#58 Phase 2 — BridgeIdentityAtlasSurface projection-only reads. -->
    <ProjectReference Include="..\..\..\packages\foundation-identity-atlas\Sunfish.Foundation.IdentityAtlas.csproj" />
    <!-- W#55 Phase 4 — Ship's Office aggregation surface (ADR 0083). -->
    <ProjectReference Include="..\..\..\packages\blocks-ships-office\Sunfish.Blocks.ShipsOffice.csproj" />
    <!-- W#54 Phase 4 — Sick Bay aggregation surface (ADR 0082). -->
    <ProjectReference Include="..\..\..\packages\blocks-sick-bay\Sunfish.Blocks.SickBay.csproj" />
    <!-- W#23.2 P2 — Equipment Asset Photo handler (EventType.Asset dispatch). -->
    <ProjectReference Include="..\..\..\packages\blocks-property-equipment\Sunfish.Blocks.PropertyEquipment.csproj" />
    <!-- W#29 Phase 3 — cockpit work-orders endpoint reads IMaintenanceService. -->
    <ProjectReference Include="..\..\..\packages\blocks-maintenance\Sunfish.Blocks.Maintenance.csproj" />
    <!-- W#62 Phase 2 — cockpit property-detail aggregation reads leases + inspections by unit. -->
    <ProjectReference Include="..\..\..\packages\blocks-leases\Sunfish.Blocks.Leases.csproj" />
    <ProjectReference Include="..\..\..\packages\blocks-inspections\Sunfish.Blocks.Inspections.csproj" />
    <!-- W#48 Phase 4 — Integration Atlas config surface (ADR 0067) -->
    <ProjectReference Include="..\..\..\packages\blocks-integrations\Sunfish.Blocks.Integrations.csproj" />
    <ProjectReference Include="..\..\..\packages\providers-mesh-headscale\Sunfish.Providers.Mesh.Headscale.csproj" />
    <ProjectReference Include="..\..\..\packages\providers-recaptcha\Sunfish.Providers.Recaptcha.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wave 5.3.C: TenantWebSocketReverseProxy.PumpAsync is internal so the
         public surface stays narrow; tests exercise it directly. -->
    <InternalsVisibleTo Include="Sunfish.Bridge.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <!-- Explicit pin: Aspire.Npgsql.EntityFrameworkCore.PostgreSQL 13.2.2's transitive
         closure resolves EntityFrameworkCore.Relational to 10.0.5, which collides with
         Sunfish.Bridge.Data.dll compiled against 10.0.6. Direct PackageReference lets
         Central Package Management (Directory.Packages.props) enforce 10.0.6 globally,
         silencing MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
