@page "/identity/recovery"
@using Sunfish.UICore.Primitives
@using Sunfish.UICore.Wayfinder
@using Sunfish.Bridge.Client.Services
@inject IIdentityAtlasSurface AtlasSurface
@inject IBridgeRequestContext RequestContext

<PageTitle>Recovery Contacts · Sunfish PM</PageTitle>

<main role="main" aria-labelledby="page-heading">
    <h1 id="page-heading">Recovery Contacts</h1>

    @if (!RequestContext.IsResolved)
    {
        <p role="status" aria-live="polite">Loading identity context…</p>
    }
    else if (_viewModel is null)
    {
        <p role="status" aria-live="polite">Loading recovery contacts…</p>
    }
    else
    {
        <section aria-labelledby="contacts-section-heading">
            <h2 id="contacts-section-heading">
                Enrolled contacts
                <span class="sf-badge" aria-label="@_viewModel.Contacts.Count of @_viewModel.MaxContacts contacts enrolled">
                    @_viewModel.Contacts.Count / @_viewModel.MaxContacts
                </span>
            </h2>

            @if (_viewModel.Contacts.Count == 0)
            {
                <p>No recovery contacts enrolled. Add contacts to enable account recovery.</p>
            }
            else
            {
                <ul aria-label="Recovery contacts list">
                    @foreach (var contact in _viewModel.Contacts)
                    {
                        <li>
                            <span class="sf-contact-name">@contact.DisplayName</span>
                            <span class="sf-contact-status" aria-label="Verification status: @contact.VerificationStatus">
                                @contact.VerificationStatus
                            </span>
                            <span class="sf-contact-date">
                                Enrolled @contact.EnrolledAt.ToString("d")
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>

        @* Diff-preview confirmation surface — ADR 0077 §4 + ADR 0066 §Phase 4. *@
        @if (PendingDiff is { Entries.Count: > 0 })
        {
            <section class="sf-diff-preview" aria-labelledby="pending-order-heading">
                <h2 id="pending-order-heading">Pending change — @PendingDiff.Summary</h2>
                <table class="sf-diff-table">
                    <caption class="sf-sr-only">Pending recovery-contact changes</caption>
                    <thead>
                        <tr>
                            <th scope="col">Field</th>
                            <th scope="col">Current</th>
                            <th scope="col">New value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in PendingDiff.Entries)
                        {
                            <tr>
                                <th scope="row">@entry.Field</th>
                                <td class="sf-diff-old">@(entry.OldValue?.ToString() ?? "—")</td>
                                <td class="sf-diff-new">
                                    <span aria-hidden="true">→ </span>@(entry.NewValue?.ToString() ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
</main>

@code {
    [CascadingParameter] public IDiffPreview? PendingDiff { get; set; }

    private RecoveryContactsViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        if (!RequestContext.IsResolved) return;
        _viewModel = await AtlasSurface.GetRecoveryContactsAsync(
            RequestContext.TenantId,
            RequestContext.ActorId);
    }
}
