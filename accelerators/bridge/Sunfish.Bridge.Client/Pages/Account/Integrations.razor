@page "/account/integrations"
@layout AccountLayout
@using Sunfish.Bridge.Client.Components.Settings.Integrations
@using Sunfish.Bridge.Client.Services
@using Sunfish.UICore.Primitives
@using Sunfish.UICore.Wayfinder.Integrations
@inject IBridgeRequestContext RequestContext
@inject IIntegrationAtlasProvider IntegrationAtlas
@inject IIntegrationAtlasContext IntegrationCtx
@inject ILiveAnnouncer LiveAnnouncer

<PageTitle>Integrations · Sunfish PM</PageTitle>

<SettingsPageHeader Title="Integrations"
                    Description="Configure third-party providers for payments, email, messaging, VPN, and CAPTCHA." />

@if (!RequestContext.IsResolved)
{
    <p role="status" aria-live="polite">Loading…</p>
}
else
{
    <AtlasIntegrationConfig Provider="IntegrationAtlas"
                            Ctx="IntegrationCtx"
                            LiveAnnouncer="LiveAnnouncer" />
}

@code {
}
