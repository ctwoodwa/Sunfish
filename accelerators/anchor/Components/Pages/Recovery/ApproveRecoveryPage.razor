@page "/recovery/approve"
@using Sunfish.Foundation.Recovery
@inject IRecoveryCoordinator Recovery

<PageTitle>Approve Recovery · Sunfish Anchor</PageTitle>

@* W#63 Phase 1 — placeholder for trustee approval flow.
   Per XO ruling 2026-05-16 (b): the trustee's Anchor session needs to
   sign the recovery-request hash with the trustee's session signing key,
   but kernel-security exposes no per-session signer-retrieval API today
   (`IKeyStore.GetCurrentKeyInfoAsync` / `IActiveSessionAccessor` both
   absent). Per the ruling's halt clause, this page is a placeholder
   pending a follow-up cob-question against kernel-security to add the
   missing session-signer accessor.

   Once the API exists, this page will:
     1. Read the pending RecoveryRequest via GetStatusAsync (or a new
        GetPendingRequestAsync surface)
     2. Compute the request hash (canonical bytes for the request)
     3. Sign with the trustee's session signer
     4. Construct TrusteeAttestation(nodeId, hash, signature)
     5. SubmitAttestationAsync(attestation) *@

<div class="recovery-approve">
    <header>
        <a class="recovery-approve__link" href="recovery/status">← Back to recovery status</a>
        <h1>Approve recovery</h1>
    </header>

    <section class="recovery-approve__placeholder">
        <strong>Coming soon.</strong>
        <p>
            The trustee approval flow requires a kernel-security API that
            isn't shipped yet (per-session signer retrieval). Until the
            follow-up lands, you can preview the pending request below.
            See the W#63 status row for the broader gap.
        </p>
    </section>

    @if (_status is not null)
    {
        <section class="recovery-approve__status">
            <h2>Pending request</h2>
            @if (_status.PendingRequest is { } req)
            {
                <dl>
                    <dt>Requesting node</dt>
                    <dd><code>@req.RequestingNodeId</code></dd>
                    <dt>Requested at</dt>
                    <dd>@req.RequestedAt.ToLocalTime()</dd>
                    <dt>Quorum progress</dt>
                    <dd>@_status.AttestationsReceived of @_status.QuorumThreshold</dd>
                </dl>
            }
            else
            {
                <p>No request is pending.</p>
            }
        </section>
    }
</div>

@code {
    private RecoveryStatus? _status;

    protected override async Task OnInitializedAsync()
    {
        try { _status = await Recovery.GetStatusAsync(default); }
        catch { /* status read is best-effort */ }
    }
}

<style>
    .recovery-approve { max-width: 720px; margin: 0 auto; padding: 1rem 1.5rem; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
    .recovery-approve__link { color: #2563eb; font-size: 0.875rem; text-decoration: none; }
    .recovery-approve__link:hover { text-decoration: underline; }
    .recovery-approve h1 { font-size: 1.75rem; margin: 0.5rem 0 1rem; letter-spacing: -0.01em; }
    .recovery-approve__placeholder { padding: 1rem 1.25rem; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 0.5rem; font-size: 0.875rem; line-height: 1.5; }
    .recovery-approve__placeholder strong { display: block; margin-bottom: 0.25rem; }
    .recovery-approve__status { margin-top: 1rem; padding: 1rem 1.25rem; border: 1px solid #e5e7eb; background: #fff; border-radius: 0.5rem; }
    .recovery-approve__status h2 { font-size: 1rem; margin: 0 0 0.5rem; }
    .recovery-approve dl { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; row-gap: 0.25rem; margin: 0; font-size: 0.875rem; }
    .recovery-approve dt { color: #6b7280; font-weight: 500; }
    .recovery-approve dd { margin: 0; color: #111827; }
    .recovery-approve code { font-family: Consolas, Menlo, monospace; }
</style>
